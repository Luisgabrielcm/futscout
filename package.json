{
  "name": "futscout",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test tests/**/*.test.ts",
    "test:watch": "tsx --test --watch tests/**/*.test.ts",
    "test:matcher": "tsx --test tests/unit/services/apiFootballPlayerMatcher.test.ts",
    "ea:sync:auto:dry-run": "tsx sync/runEARatingsAutoSync.ts --dry-run",
    "ea:sync:auto:write": "tsx sync/runEARatingsAutoSync.ts --write",
    "ea:gk:audit": "tsx sync/runEAGoalkeeperAttributesAudit.ts --dry-run",
    "ea:gk:sync:dry-run": "tsx sync/runEAGoalkeeperAttributesSync.ts --dry-run",
    "ea:gk:sync:write": "tsx sync/runEAGoalkeeperAttributesSync.ts --write",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
