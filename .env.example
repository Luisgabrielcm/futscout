# Pooled PostgreSQL connection used by the public application runtime (including Vercel).
# Never prefix database credentials with NEXT_PUBLIC_. SSL is provider-specific.
DATABASE_URL=

# Direct PostgreSQL connection reserved for Prisma CLI/admin operations.
DIRECT_URL=

# Read-only official lineup UI. Enable only after the separately approved migration.
OFFICIAL_LINEUPS_ENABLED=false

# Public origin: REQUIRED for production build (robots/sitemap); rebuild if changed.
SITE_URL="http://localhost:3000"

# Operational only: NOT required to install/build/run the public catalog.
# API_FOOTBALL_KEY=""

# Optional operational database retry tuning (existing defaults apply if omitted).
# DATABASE_MAX_RETRIES=3
# DATABASE_RETRY_DELAY_MS=2000
# DATABASE_OPERATION_TIMEOUT_MS=20000

# Optional EA sync/audit/repair tuning. Never executed by install/build/start.
# EA_SYNC_BATCH_SIZE=100
# EA_SYNC_MAX_BATCHES=1
# EA_SYNC_DELAY_MS=1000
# EA_SYNC_MAX_RETRIES=5
# EA_SYNC_RETRY_DELAY_MS=2000
# EA_AUDIT_BATCH_SIZE=100
# EA_AUDIT_DELAY_MS=1000
# EA_REPAIR_BATCH_SIZE=100
# EA_REPAIR_DELAY_MS=1000

# Incremental EA auto-sync runner. Dry-run is explicit and read-only; write mode
# additionally requires EA_AUTO_SYNC_WRITE_ENABLED=true and an applied provenance migration.
# Scheduling frequency belongs to the external scheduler and is not hardcoded here.
# EA_AUTO_SYNC_BATCH_SIZE=50
# EA_AUTO_SYNC_MAX_BATCHES=1
# EA_AUTO_SYNC_LOCALE=en
# EA_AUTO_SYNC_GENDER=0
# EA_AUTO_SYNC_WRITE_ENABLED=false
